{
    "name": "voicetel/voiceml",
    "version": "0.9.1",
    "description": "Official PHP SDK for the VoiceML REST API (Twilio-compatible voice + AMD service from VoiceTel)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://voiceml.voicetel.com",
    "authors": [
        {
            "name": "VoiceTel",
            "email": "support@voicetel.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "VoiceML\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VoiceML\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
