{
    "name": "voicetel/voiceml",
    "description": "Official PHP SDK for the VoiceML REST API (Twilio-compatible voice + AMD service from VoiceTel)",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://voicetel.com/docs/api/v0.9/voiceml/",
    "authors": [
        {
            "name": "VoiceTel",
            "email": "support@voicetel.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "VoiceML\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VoiceML\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    }
}
